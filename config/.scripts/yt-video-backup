#!/bin/bash
set -euo pipefail

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  echo 'Usage: yt-video-backup <project-folder-or-absolute-path>' >&2
  echo 'Example: yt-video-backup 2026/2026-11-03-my-video' >&2
  exit 1
fi

project_root="$HOME/Movies/Final Cut Projects/YouTube"
case "$1" in
  /*) source=$1 ;;
  *) source="$project_root/$1" ;;
esac

if [ ! -d "$source" ] || [ -L "$source" ]; then
  echo "Project folder not found or is a symlink: $source" >&2
  exit 1
fi

project_root=$(cd "$project_root" && pwd -P)
source=$(cd "$source" && pwd -P)
case "$source" in
  "$project_root"/*/*) ;;
  *) echo "Project must be inside a year folder under $project_root" >&2; exit 1 ;;
esac
relative=${source#"$project_root"/}
year=${relative%%/*}
project=${relative#*/}
if [[ ! "$year" =~ ^[0-9]{4}$ || "$project" == */* ]]; then
  echo 'Expected a single project folder under a four-digit year.' >&2
  exit 1
fi

for app in 'Final Cut Pro' Motion 'Logic Pro' Compressor; do
  if pgrep -x "$app" >/dev/null; then
    echo "Close $app before backing up the project." >&2
    exit 1
  fi
done

if [ -z "${MEDIA_BACKUP_DRIVE:-}" ]; then
  echo 'Set MEDIA_BACKUP_DRIVE in ~/.secrets and open a new terminal.' >&2
  exit 1
fi
drive=${MEDIA_BACKUP_DRIVE%/}

youtube_drive="$drive/My Drive/MultiMedia Projects/Social Media/YouTube"
if [ ! -d "$youtube_drive" ] || [ -L "$youtube_drive" ]; then
  echo "Google Drive YouTube folder is unavailable: $youtube_drive" >&2
  exit 1
fi

parent="$youtube_drive/Editing/$year"
destination="$parent/$project"
if [ -L "$youtube_drive/Editing" ] || [ -L "$parent" ]; then
  echo "Refusing a symlink in the backup destination: $parent" >&2
  exit 1
fi
if [ -e "$destination" ] || [ -L "$destination" ]; then
  echo "Backup already exists; review it before replacing anything: $destination" >&2
  exit 1
fi

mkdir -p "$parent"
temporary="$parent/.incomplete-$project-$$"
echo "Copying $source"
ditto "$source" "$temporary"
if ! differences=$(rsync -rltcni --delete "$source/" "$temporary/" 2>&1); then
  echo "$differences" >&2
  echo "Copy check failed. Review the incomplete copy: $temporary" >&2
  exit 1
fi
if [ -n "$differences" ]; then
  echo "$differences" >&2
  echo "Copy check failed. Review the incomplete copy: $temporary" >&2
  exit 1
fi
mv "$temporary" "$destination"
echo "Local copy verified: $destination"
echo 'Wait for Google Drive to show Up to date, then verify the remote folder before removing originals.'
