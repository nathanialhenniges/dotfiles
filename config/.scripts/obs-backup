#!/bin/bash
set -euo pipefail

SOURCE="$HOME/Movies/OBS"
LOG="$HOME/Movies/OBS/.backup.log"

# Resolve the Google Drive mount at runtime instead of hardcoding it.
#
# This matters for more than privacy. The old absolute path pinned one Mac
# username and one Drive account, and `mkdir -p "$DEST"` below will happily
# CREATE that literal path on a machine where Drive is not mounted. rsync then
# copies into a dead local folder, reports success, and the cleanup further
# down deletes the originals. Nothing fails, so `set -e` never fires.
#
# Override with MEDIA_BACKUP_DRIVE (e.g. exported from ~/.secrets) if your
# Drive lives somewhere else.
resolve_drive() {
  local d
  if [[ -n "${MEDIA_BACKUP_DRIVE:-}" ]]; then
    [[ -d "$MEDIA_BACKUP_DRIVE/My Drive" ]] && { printf '%s' "${MEDIA_BACKUP_DRIVE%/}"; return 0; }
    return 1
  fi
  for d in "$HOME/Library/CloudStorage/GoogleDrive-"*/; do
    [[ -d "$d/My Drive" ]] && { printf '%s' "${d%/}"; return 0; }
  done
  return 1
}

if ! DRIVE=$(resolve_drive); then
  echo "❌ Google Drive is not mounted under ~/Library/CloudStorage." >&2
  echo "   Open Google Drive and wait for it to sign in, or set MEDIA_BACKUP_DRIVE." >&2
  echo "   Aborting before anything is copied or deleted." >&2
  exit 1
fi

DEST="$DRIVE/My Drive/MultiMedia Projects/Social Media/Recording"

echo "▶ OBS backup started at $(date)" | tee -a "$LOG"
echo "" | tee -a "$LOG"

# Ensure destination subfolders exist
mkdir -p "$DEST/Raw" "$DEST/Edits" "$DEST/Clips" "$DEST/Exports"

# ── Edits, Clips, Exports — sync then auto-delete local ──────────────────
for FOLDER in Edits Clips Exports; do
  SRC="$SOURCE/$FOLDER/"
  DST="$DEST/$FOLDER/"

  # Skip if folder is empty
  if [ -z "$(ls -A "$SRC" 2>/dev/null)" ]; then
    echo "⏭  $FOLDER — empty, skipping" | tee -a "$LOG"
    continue
  fi

  echo "▶ Syncing $FOLDER to Google Drive..." | tee -a "$LOG"
  rsync -av --update \
    --exclude='.DS_Store' \
    "$SRC" "$DST" 2>&1 | tee -a "$LOG"

  echo "🗑  Clearing local $FOLDER (files are on Google Drive)..." | tee -a "$LOG"
  find "$SRC" -mindepth 1 -not -name '.DS_Store' -delete
  echo "✅ $FOLDER synced and cleared" | tee -a "$LOG"
  echo "" | tee -a "$LOG"
done

# ── Raw — sync then prompt before deleting ───────────────────────────────
RAW_SRC="$SOURCE/Raw/"
RAW_DST="$DEST/Raw/"

if [ -z "$(ls -A "$RAW_SRC" 2>/dev/null)" ]; then
  echo "⏭  Raw — empty, skipping" | tee -a "$LOG"
else
  echo "▶ Syncing Raw to Google Drive..." | tee -a "$LOG"
  rsync -av --update \
    --exclude='.DS_Store' \
    "$RAW_SRC" "$RAW_DST" 2>&1 | tee -a "$LOG"

  echo "✅ Raw synced to Google Drive" | tee -a "$LOG"
  echo "" | tee -a "$LOG"

  RAW_SIZE=$(du -sh "$RAW_SRC" 2>/dev/null | cut -f1)
  RAW_COUNT=$(find "$RAW_SRC" -mindepth 1 -not -name '.DS_Store' | wc -l | tr -d ' ')
  echo "Raw files on disk: $RAW_COUNT files, $RAW_SIZE" | tee -a "$LOG"
  echo ""
  read -r -p "Delete local Raw files? They are now on Google Drive. (y/N) " CONFIRM
  if [[ "${CONFIRM:-}" =~ ^[Yy]$ ]]; then
    find "$RAW_SRC" -mindepth 1 -not -name '.DS_Store' -delete
    echo "🗑  Local Raw files cleared" | tee -a "$LOG"
  else
    echo "⏭  Raw files kept locally" | tee -a "$LOG"
  fi
fi

echo "" | tee -a "$LOG"
echo "✅ OBS backup complete at $(date)" | tee -a "$LOG"
