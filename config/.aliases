# ─── Network ────────────────────────────────────────────────────────────────
# hotspot [on|off|status] — with no argument, flips the current state.
# Sets IPv4 TTL and IPv6 hop limit together; macOS resets both to 64 on reboot.
hotspot() {
  local ttl hlim
  ttl=$(sysctl -n net.inet.ip.ttl)
  case "${1:-toggle}" in
    on) ttl=65 ;;
    off) ttl=64 ;;
    toggle) [[ $ttl == 65 ]] && ttl=64 || ttl=65 ;;
    status)
      hlim=$(sysctl -n net.inet6.ip6.hlim)
      echo "hotspot: $([[ $ttl == 65 ]] && echo on || echo off) (ttl=$ttl hlim=$hlim)"
      return ;;
    *) echo "usage: hotspot [on|off|status]" >&2; return 1 ;;
  esac
  sudo sysctl -q net.inet.ip.ttl=$ttl net.inet6.ip6.hlim=$ttl >/dev/null && hotspot status
}

# ─── Listing (eza) ──────────────────────────────────────────────────────────
if command -v eza &>/dev/null; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -lh --icons --group-directories-first --git'
  alias la='eza -lah --icons --group-directories-first --git'
  alias lt='eza --tree --level=2 --icons --group-directories-first'
fi

# ─── Navigation ─────────────────────────────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ─── Utilities ──────────────────────────────────────────────────────────────
alias rmdsstore='find . -name ".DS_Store" -type f -delete'
alias markedit='open -a "MarkEdit"'

# bat keeps cat readable in terminals and plain in pipes.
if command -v bat &>/dev/null; then
  alias cat='bat --paging=never'
fi

# ─── Dotfiles ───────────────────────────────────────────────────────────────
if [[ "$(uname -s)" == "Darwin" ]]; then
  alias dots='(cd "$HOME/Developer/nathanialhenniges/dotfiles" && ./sync.sh)'
fi

# ─── Media Conversion ───────────────────────────────────────────────────────
alias movtogif='function _movtogif() { local out="${2:-${1%.*}.gif}"; ffmpeg -hwaccel videotoolbox -i "$1" -vf "fps=15,scale=600:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" -loop 0 "$out"; }; _movtogif'
alias towebm='function _towebm() { local out="${2:-${1%.*}.webm}"; ffmpeg -hwaccel videotoolbox -i "$1" -c:v libvpx-vp9 -crf 33 -b:v 0 -c:a libopus -vbr on -compression_level 10 "$out"; }; _towebm'
alias towebmp4='function _towebmp4() { local out="${2:-${1%.*}.mp4}"; ffmpeg -hwaccel videotoolbox -i "$1" -c:v h264_videotoolbox -q:v 65 -c:a aac -movflags +faststart "$out"; }; _towebmp4'

alias yolo="claude --dangerously-skip-permissions"

# ─── Video / Media Scripts ──────────────────────────────────────────────────
alias yt-video-backup='~/.scripts/yt-video-backup'
alias new-video='~/.scripts/new-video'
alias obs-backup='~/.scripts/obs-backup'
