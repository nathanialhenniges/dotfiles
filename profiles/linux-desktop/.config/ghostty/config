# Linux desktop Ghostty profile. macOS-only options intentionally omitted.
font-family = Cascadia Code
font-size = 13
theme = light:Monokai Pro Octagon,dark:Monokai Pro Octagon
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
shell-integration = zsh
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = true
