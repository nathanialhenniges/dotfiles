# Small, portable Linux desktop aliases. No Mac, server, or project shortcuts.
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'
alias grep='grep --color=auto'

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -lh --group-directories-first --git'
  alias la='eza -lah --group-directories-first --git'
  alias lt='eza --tree --level=2 --group-directories-first'
else
  alias ll='ls -lhF'
  alias la='ls -lahF'
fi

# Chrome Remote Desktop host conflicts with local GNOME. Start only from TTY after logout.
alias crd-start-tty='/opt/google/chrome-remote-desktop/chrome-remote-desktop --start'
alias crd-status='/opt/google/chrome-remote-desktop/chrome-remote-desktop --get-status'
alias crd-stop='/opt/google/chrome-remote-desktop/chrome-remote-desktop --stop'
